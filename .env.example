# GCP Project Configuration
GCP_PROJECT=kayrox-last-call
GCP_REGION=europe-west1

# Vertex AI Models & Endpoints (Single Multi-Region EU endpoint for both models)
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_FLASH_REGION=eu
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_REGION=eu

# Application Security
APP_SIGNING_KEY=replace_with_secret_in_secret_manager

# Service Defaults
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO
