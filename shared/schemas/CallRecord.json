{
  "$defs": {
    "BuyerInfo": {
      "properties": {
        "buyer_id": {
          "title": "Buyer Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "juice_shop",
            "restaurant",
            "bakery",
            "charity",
            "dairy_farm",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "phone": {
          "title": "Phone",
          "type": "string"
        }
      },
      "required": [
        "buyer_id",
        "name",
        "type",
        "phone"
      ],
      "title": "BuyerInfo",
      "type": "object"
    },
    "CallResult": {
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "mart_id": {
          "title": "Mart Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "deal_type": {
          "default": "sale",
          "enum": [
            "sale",
            "donation"
          ],
          "title": "Deal Type",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "deal",
                "partial_deal",
                "declined",
                "call_back",
                "wants_photo",
                "wants_manager",
                "do_not_call",
                "no_answer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "agreed_price_per_unit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreed Price Per Unit"
        },
        "agreed_price_unit": {
          "anyOf": [
            {
              "enum": [
                "kg",
                "dozen"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreed Price Unit"
        },
        "currency": {
          "const": "PKR",
          "default": "PKR",
          "title": "Currency",
          "type": "string"
        },
        "agreed_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreed Quantity"
        },
        "agreed_quantity_unit": {
          "anyOf": [
            {
              "enum": [
                "kg",
                "dozen"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreed Quantity Unit"
        },
        "pickup_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pickup Time"
        },
        "callback_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback At"
        },
        "transcript": {
          "items": {
            "$ref": "#/$defs/TranscriptEntry"
          },
          "title": "Transcript",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "call_id",
        "batch_id",
        "mart_id",
        "status"
      ],
      "title": "CallResult",
      "type": "object"
    },
    "CallingHours": {
      "properties": {
        "start": {
          "format": "time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "title": "CallingHours",
      "type": "object"
    },
    "DealBrief": {
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "mart_id": {
          "title": "Mart Id",
          "type": "string"
        },
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "deal_type": {
          "default": "sale",
          "enum": [
            "sale",
            "donation"
          ],
          "title": "Deal Type",
          "type": "string"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "quantity_unit": {
          "enum": [
            "kg",
            "dozen"
          ],
          "title": "Quantity Unit",
          "type": "string"
        },
        "quantity_confirmed_by_staff": {
          "default": false,
          "title": "Quantity Confirmed By Staff",
          "type": "boolean"
        },
        "buyer": {
          "$ref": "#/$defs/BuyerInfo"
        },
        "opening_price_per_unit": {
          "minimum": 0,
          "title": "Opening Price Per Unit",
          "type": "integer"
        },
        "opening_price_unit": {
          "enum": [
            "kg",
            "dozen"
          ],
          "title": "Opening Price Unit",
          "type": "string"
        },
        "floor_price_per_unit": {
          "minimum": 0,
          "title": "Floor Price Per Unit",
          "type": "integer"
        },
        "floor_price_unit": {
          "enum": [
            "kg",
            "dozen"
          ],
          "title": "Floor Price Unit",
          "type": "string"
        },
        "market_rate_per_unit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Rate Per Unit"
        },
        "currency": {
          "const": "PKR",
          "default": "PKR",
          "title": "Currency",
          "type": "string"
        },
        "pickup_window": {
          "title": "Pickup Window",
          "type": "string"
        },
        "pickup_deadline": {
          "format": "date-time",
          "title": "Pickup Deadline",
          "type": "string"
        },
        "mart": {
          "$ref": "#/$defs/MartInfo"
        },
        "payment_terms": {
          "title": "Payment Terms",
          "type": "string"
        },
        "language": {
          "default": "ur",
          "enum": [
            "ur",
            "en",
            "pa"
          ],
          "title": "Language",
          "type": "string"
        },
        "calling_hours": {
          "$ref": "#/$defs/CallingHours"
        }
      },
      "required": [
        "mart_id",
        "batch_id",
        "call_id",
        "item",
        "condition",
        "quantity",
        "quantity_unit",
        "buyer",
        "opening_price_per_unit",
        "opening_price_unit",
        "floor_price_per_unit",
        "floor_price_unit",
        "pickup_window",
        "pickup_deadline",
        "mart",
        "payment_terms",
        "calling_hours"
      ],
      "title": "DealBrief",
      "type": "object"
    },
    "MartInfo": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "name",
        "location"
      ],
      "title": "MartInfo",
      "type": "object"
    },
    "NegotiationPolicy": {
      "properties": {
        "concession_fractions": {
          "items": {
            "type": "number"
          },
          "title": "Concession Fractions",
          "type": "array"
        },
        "round_to": {
          "default": 5,
          "title": "Round To",
          "type": "integer"
        },
        "max_call_seconds": {
          "default": 300,
          "title": "Max Call Seconds",
          "type": "integer"
        },
        "wrapup_warning_seconds": {
          "default": 30,
          "title": "Wrapup Warning Seconds",
          "type": "integer"
        }
      },
      "title": "NegotiationPolicy",
      "type": "object"
    },
    "NegotiationState": {
      "properties": {
        "ladder": {
          "items": {
            "type": "integer"
          },
          "title": "Ladder",
          "type": "array"
        },
        "rung": {
          "default": 0,
          "title": "Rung",
          "type": "integer"
        },
        "approved_prices": {
          "items": {
            "type": "integer"
          },
          "title": "Approved Prices",
          "type": "array"
        },
        "last_buyer_offer": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Buyer Offer"
        },
        "accepted_price": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Price"
        },
        "quoted": {
          "default": false,
          "title": "Quoted",
          "type": "boolean"
        }
      },
      "required": [
        "ladder"
      ],
      "title": "NegotiationState",
      "type": "object"
    },
    "TranscriptEntry": {
      "properties": {
        "speaker": {
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "text",
        "at"
      ],
      "title": "TranscriptEntry",
      "type": "object"
    },
    "UsageRecord": {
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "properties": {
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "mart_id": {
      "title": "Mart Id",
      "type": "string"
    },
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "brief": {
      "$ref": "#/$defs/DealBrief"
    },
    "policy": {
      "$ref": "#/$defs/NegotiationPolicy"
    },
    "negotiation": {
      "$ref": "#/$defs/NegotiationState"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "session_nonce": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Nonce"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CallResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transcript": {
      "items": {
        "$ref": "#/$defs/TranscriptEntry"
      },
      "title": "Transcript",
      "type": "array"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expire_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expire At"
    },
    "usage": {
      "$ref": "#/$defs/UsageRecord"
    }
  },
  "required": [
    "call_id",
    "mart_id",
    "batch_id",
    "brief",
    "policy",
    "negotiation",
    "created_at"
  ],
  "title": "CallRecord",
  "type": "object"
}