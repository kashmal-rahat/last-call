    "key": {
      "title": "Key",
      "type": "string"
    },
    "mart_id": {
      "title": "Mart Id",
      "type": "string"
    },
    "inspection_id": {
      "title": "Inspection Id",
      "type": "string"
    },
    "item_key": {
      "title": "Item Key",
      "type": "string"
    },
    "branch_id": {
      "title": "Branch Id",
      "type": "string"
    },
    "branch_name": {
      "title": "Branch Name",
      "type": "string"
    },
    "step": {
      "enum": [
        "bulk_sale",
        "donate",
        "animal_feed"
      ],
