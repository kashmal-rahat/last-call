      "type": "string"
    },
    "buyer_types": {
      "items": {
        "enum": [
          "juice_shop",
          "restaurant",
          "bakery",
          "charity",
          "dairy_farm",
          "other"
        ],
        "type": "string"
      },
      "title": "Buyer Types",
      "type": "array"
    },
    "searched_at": {
      "format": "date-time",
      "title": "Searched At",
      "type": "string"
    },
    "expire_at": {
      "format": "date-time",
