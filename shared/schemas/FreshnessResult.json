{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "ymin": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ymin",
          "type": "number"
        },
        "xmin": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Xmin",
          "type": "number"
        },
        "ymax": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ymax",
          "type": "number"
        },
        "xmax": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Xmax",
          "type": "number"
        }
      },
      "required": [
        "ymin",
        "xmin",
        "ymax",
        "xmax"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "InspectorMeta": {
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "thinking_level": {
          "title": "Thinking Level",
          "type": "string"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "integer"
        },
        "calls": {
          "default": 1,
          "title": "Calls",
          "type": "integer"
        },
        "hedges": {
          "default": 0,
          "title": "Hedges",
          "type": "integer"
        },
        "zoomed_groups": {
          "default": 0,
          "title": "Zoomed Groups",
          "type": "integer"
        },
        "zoom_failures": {
          "default": 0,
          "title": "Zoom Failures",
          "type": "integer"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cached_tokens": {
          "default": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "thoughts_tokens": {
          "default": 0,
          "title": "Thoughts Tokens",
          "type": "integer"
        },
        "candidates_tokens": {
          "default": 0,
          "title": "Candidates Tokens",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "prompt_version",
        "thinking_level",
        "latency_ms"
      ],
      "title": "InspectorMeta",
      "type": "object"
    },
    "ItemAssessment": {
      "properties": {
        "item_key": {
          "title": "Item Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/BoundingBox"
        },
        "grid": {
          "title": "Grid",
          "type": "string"
        },
        "in_mixed_crate": {
          "default": false,
          "title": "In Mixed Crate",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "enum": [
              "bruising",
              "browning",
              "dark_spots",
              "yellowing",
              "wilting",
              "shrivelling",
              "soft_spots",
              "splitting",
              "leaking",
              "pest_damage",
              "rot",
              "slime",
              "mould"
            ],
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "stage": {
          "enum": [
            "fresh",
            "ripening",
            "overripe",
            "spoiled",
            "unsafe"
          ],
          "title": "Stage",
          "type": "string"
        },
        "stage_level": {
          "enum": [
            "early",
            "mid",
            "late"
          ],
          "title": "Stage Level",
          "type": "string"
        },
        "worst_stage": {
          "enum": [
            "fresh",
            "ripening",
            "overripe",
            "spoiled",
            "unsafe"
          ],
          "title": "Worst Stage",
          "type": "string"
        },
        "score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "change_since_last": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Since Last"
        },
        "change_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Note"
        },
        "observed": {
          "$ref": "#/$defs/ObservedQuantity"
        },
        "quantity": {
          "$ref": "#/$defs/QuantityEstimate"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_level": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence Level",
          "type": "string"
        },
        "needs_staff_check": {
          "default": false,
          "title": "Needs Staff Check",
          "type": "boolean"
        },
        "staff_check_reasons": {
          "items": {
            "enum": [
              "spoiled_or_unsafe",
              "bad_pieces_in_group",
              "low_confidence",
              "unknown_produce",
              "mixed_crate",
              "safety_override",
              "model_flagged",
              "zoom_disagreement"
            ],
            "type": "string"
          },
          "title": "Staff Check Reasons",
          "type": "array"
        },
        "check_reason": {
          "default": "",
          "title": "Check Reason",
          "type": "string"
        },
        "zoomed": {
          "default": false,
          "title": "Zoomed",
          "type": "boolean"
        }
      },
      "required": [
        "item_key",
        "name",
        "position",
        "grid",
        "stage",
        "stage_level",
        "worst_stage",
        "score",
        "observed",
        "quantity",
        "confidence",
        "confidence_level"
      ],
      "title": "ItemAssessment",
      "type": "object"
    },
    "ObservedQuantity": {
      "properties": {
        "method": {
          "enum": [
            "count",
            "fill_level"
          ],
          "title": "Method",
          "type": "string"
        },
        "min": {
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "minimum": 0,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "min",
        "max"
      ],
      "title": "ObservedQuantity",
      "type": "object"
    },
    "QuantityEstimate": {
      "properties": {
        "unit": {
          "enum": [
            "kg",
            "dozen"
          ],
          "title": "Unit",
          "type": "string"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "low",
        "high"
      ],
      "title": "QuantityEstimate",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mart_id": {
      "title": "Mart Id",
      "type": "string"
    },
    "shelf_id": {
      "title": "Shelf Id",
      "type": "string"
    },
    "inspection_id": {
      "title": "Inspection Id",
      "type": "string"
    },
    "previous_inspection_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Inspection Id"
    },
    "photo_uri": {
      "title": "Photo Uri",
      "type": "string"
    },
    "taken_at": {
      "format": "date-time",
      "title": "Taken At",
      "type": "string"
    },
    "photo_status": {
      "default": "ok",
      "enum": [
        "ok",
        "no_produce",
        "unreadable"
      ],
      "title": "Photo Status",
      "type": "string"
    },
    "photo_note": {
      "default": "",
      "title": "Photo Note",
      "type": "string"
    },
    "photo_issues": {
      "items": {
        "enum": [
          "blurry",
          "too_dark",
          "overexposed",
          "glare",
          "partly_blocked",
          "too_far",
          "instruction_text"
        ],
        "type": "string"
      },
      "title": "Photo Issues",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemAssessment"
      },
      "title": "Items",
      "type": "array"
    },
    "inspector": {
      "anyOf": [
        {
          "$ref": "#/$defs/InspectorMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "mart_id",
    "shelf_id",
    "inspection_id",
    "photo_uri",
    "taken_at",
    "items"
  ],
  "title": "FreshnessResult",
  "type": "object"
}