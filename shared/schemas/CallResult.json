{
  "$defs": {
    "TranscriptEntry": {
      "properties": {
        "speaker": {
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "text",
        "at"
      ],
      "title": "TranscriptEntry",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "mart_id": {
      "title": "Mart Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "deal_type": {
      "default": "sale",
      "enum": [
        "sale",
        "donation"
      ],
      "title": "Deal Type",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "deal",
            "partial_deal",
            "declined",
            "call_back",
            "wants_photo",
            "wants_manager",
            "do_not_call",
            "no_answer"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "agreed_price_per_unit": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agreed Price Per Unit"
    },
    "agreed_price_unit": {
      "anyOf": [
        {
          "enum": [
            "kg",
            "dozen"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agreed Price Unit"
    },
    "currency": {
      "const": "PKR",
      "default": "PKR",
      "title": "Currency",
      "type": "string"
    },
    "agreed_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agreed Quantity"
    },
    "agreed_quantity_unit": {
      "anyOf": [
        {
          "enum": [
            "kg",
            "dozen"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agreed Quantity Unit"
    },
    "pickup_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pickup Time"
    },
    "callback_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Callback At"
    },
    "transcript": {
      "items": {
        "$ref": "#/$defs/TranscriptEntry"
      },
      "title": "Transcript",
      "type": "array"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    }
  },
  "required": [
    "call_id",
    "batch_id",
    "mart_id",
    "status"
  ],
  "title": "CallResult",
  "type": "object"
}