{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "ymin": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ymin",
          "type": "number"
        },
        "xmin": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Xmin",
          "type": "number"
        },
        "ymax": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ymax",
          "type": "number"
        },
        "xmax": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Xmax",
          "type": "number"
        }
      },
      "required": [
        "ymin",
        "xmin",
        "ymax",
        "xmax"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ObservedQuantity": {
      "properties": {
        "method": {
          "enum": [
            "count",
            "fill_level"
          ],
          "title": "Method",
          "type": "string"
        },
        "min": {
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "minimum": 0,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "min",
        "max"
      ],
      "title": "ObservedQuantity",
      "type": "object"
    },
    "QuantityEstimate": {
      "properties": {
        "unit": {
          "enum": [
            "kg",
            "dozen"
          ],
          "title": "Unit",
          "type": "string"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "low",
        "high"
      ],
      "title": "QuantityEstimate",
      "type": "object"
    }
  },
  "properties": {
    "item_key": {
      "title": "Item Key",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "position": {
      "$ref": "#/$defs/BoundingBox"
    },
    "grid": {
      "title": "Grid",
      "type": "string"
    },
    "in_mixed_crate": {
      "default": false,
      "title": "In Mixed Crate",
      "type": "boolean"
    },
    "issues": {
      "items": {
        "enum": [
          "bruising",
          "browning",
          "dark_spots",
          "yellowing",
          "wilting",
          "shrivelling",
          "soft_spots",
          "splitting",
          "leaking",
          "pest_damage",
          "rot",
          "slime",
          "mould"
        ],
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "evidence": {
      "default": "",
      "title": "Evidence",
      "type": "string"
    },
    "stage": {
      "enum": [
        "fresh",
        "ripening",
        "overripe",
        "spoiled",
        "unsafe"
      ],
      "title": "Stage",
      "type": "string"
    },
    "stage_level": {
      "enum": [
        "early",
        "mid",
        "late"
      ],
      "title": "Stage Level",
      "type": "string"
    },
    "worst_stage": {
      "enum": [
        "fresh",
        "ripening",
        "overripe",
        "spoiled",
        "unsafe"
      ],
      "title": "Worst Stage",
      "type": "string"
    },
    "score": {
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "change_since_last": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Change Since Last"
    },
    "change_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Change Note"
    },
    "observed": {
      "$ref": "#/$defs/ObservedQuantity"
    },
    "quantity": {
      "$ref": "#/$defs/QuantityEstimate"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "confidence_level": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence Level",
      "type": "string"
    },
    "needs_staff_check": {
      "default": false,
      "title": "Needs Staff Check",
      "type": "boolean"
    },
    "staff_check_reasons": {
      "items": {
        "enum": [
          "spoiled_or_unsafe",
          "bad_pieces_in_group",
          "low_confidence",
          "unknown_produce",
          "mixed_crate",
          "safety_override",
          "model_flagged",
          "zoom_disagreement"
        ],
        "type": "string"
      },
      "title": "Staff Check Reasons",
      "type": "array"
    },
    "check_reason": {
      "default": "",
      "title": "Check Reason",
      "type": "string"
    },
    "zoomed": {
      "default": false,
      "title": "Zoomed",
      "type": "boolean"
    }
  },
  "required": [
    "item_key",
    "name",
    "position",
    "grid",
    "stage",
    "stage_level",
    "worst_stage",
    "score",
    "observed",
    "quantity",
    "confidence",
    "confidence_level"
  ],
  "title": "ItemAssessment",
  "type": "object"
}