{
  "$defs": {
    "Branch": {
      "properties": {
        "branch_id": {
          "title": "Branch Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "geo": {
          "$ref": "#/$defs/GeoPoint"
        }
      },
      "required": [
        "branch_id",
        "name",
        "location",
        "geo"
      ],
      "title": "Branch",
      "type": "object"
    },
    "CallingHours": {
      "properties": {
        "start": {
          "format": "time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "title": "CallingHours",
      "type": "object"
    },
    "GeoPoint": {
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "MartInfo": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "name",
        "location"
      ],
      "title": "MartInfo",
      "type": "object"
    },
    "PriceEntry": {
      "properties": {
        "names": {
          "items": {
            "type": "string"
          },
          "title": "Names",
          "type": "array"
        },
        "prices": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "kg",
              "dozen"
            ]
          },
          "title": "Prices",
          "type": "object"
        }
      },
      "required": [
        "names",
        "prices"
      ],
      "title": "PriceEntry",
      "type": "object"
    }
  },
  "properties": {
    "mart_id": {
      "title": "Mart Id",
      "type": "string"
    },
    "mart": {
      "$ref": "#/$defs/MartInfo"
    },
    "timezone": {
      "default": "Asia/Karachi",
      "title": "Timezone",
      "type": "string"
    },
    "closing_time": {
      "format": "time",
      "title": "Closing Time",
      "type": "string"
    },
    "opening_time": {
      "default": "09:00:00",
      "format": "time",
      "title": "Opening Time",
      "type": "string"
    },
    "bulk_pickup_hours": {
      "default": 2.0,
      "title": "Bulk Pickup Hours",
      "type": "number"
    },
    "pickup_window_hours": {
      "default": 3.0,
      "title": "Pickup Window Hours",
      "type": "number"
    },
    "discount_window_hours": {
      "default": 6,
      "title": "Discount Window Hours",
      "type": "number"
    },
    "max_discount_pct": {
      "default": 40,
      "title": "Max Discount Pct",
      "type": "integer"
    },
    "min_discount_pct": {
      "default": 10,
      "title": "Min Discount Pct",
      "type": "integer"
    },
    "bulk_open_pct": {
      "default": 60,
      "title": "Bulk Open Pct",
      "type": "integer"
    },
    "bulk_floor_pct": {
      "default": 35,
      "title": "Bulk Floor Pct",
      "type": "integer"
    },
    "feed_open_pct": {
      "default": 15,
      "title": "Feed Open Pct",
      "type": "integer"
    },
    "feed_floor_pct": {
      "default": 5,
      "title": "Feed Floor Pct",
      "type": "integer"
    },
    "price_round_to": {
      "default": 5,
      "title": "Price Round To",
      "type": "integer"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "prices": {
      "items": {
        "$ref": "#/$defs/PriceEntry"
      },
      "title": "Prices",
      "type": "array"
    },
    "branches": {
      "items": {
        "$ref": "#/$defs/Branch"
      },
      "title": "Branches",
      "type": "array"
    },
    "default_branch_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Branch Id"
    },
    "scout_radius_km": {
      "default": 10.0,
      "title": "Scout Radius Km",
      "type": "number"
    },
    "buyer_cooldown_hours": {
      "default": 24.0,
      "title": "Buyer Cooldown Hours",
      "type": "number"
    },
    "scout_max_buyers": {
      "default": 5,
      "title": "Scout Max Buyers",
      "type": "integer"
    },
    "payment_terms": {
      "default": "Cash on pickup",
      "title": "Payment Terms",
      "type": "string"
    },
    "calling_hours": {
      "$ref": "#/$defs/CallingHours"
    },
    "city_style": {
      "default": "karachi",
      "enum": [
        "karachi",
        "lahore",
        "islamabad"
      ],
      "title": "City Style",
      "type": "string"
    }
  },
  "required": [
    "mart_id",
    "mart",
    "closing_time",
    "prices"
  ],
  "title": "MartRules",
  "type": "object"
}