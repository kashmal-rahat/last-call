{
  "$defs": {
    "AgentBuyerInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "juice_shop",
            "restaurant",
            "bakery",
            "charity",
            "dairy_farm",
            "other"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "AgentBuyerInfo",
      "type": "object"
    },
    "CallingHours": {
      "properties": {
        "start": {
          "format": "time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "title": "CallingHours",
      "type": "object"
    },
    "MartInfo": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "name",
        "location"
      ],
      "title": "MartInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The view of DealBrief exposed to the negotiation agent.\n\nIntentionally excludes floor_price_per_unit, floor_price_unit, buyer.phone,\nand buyer.buyer_id to prevent leakage during prompt compilation or reasoning.\nextra=\"forbid\" means a new DealBrief field breaks agent_view() until someone\ndecides whether the agent may see it.",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mart_id": {
      "title": "Mart Id",
      "type": "string"
    },
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "deal_type": {
      "default": "sale",
      "enum": [
        "sale",
        "donation"
      ],
      "title": "Deal Type",
      "type": "string"
    },
    "item": {
      "title": "Item",
      "type": "string"
    },
    "condition": {
      "title": "Condition",
      "type": "string"
    },
    "quantity": {
      "exclusiveMinimum": 0,
      "title": "Quantity",
      "type": "number"
    },
    "quantity_unit": {
      "enum": [
        "kg",
        "dozen"
      ],
      "title": "Quantity Unit",
      "type": "string"
    },
    "quantity_confirmed_by_staff": {
      "default": false,
      "title": "Quantity Confirmed By Staff",
      "type": "boolean"
    },
    "buyer": {
      "$ref": "#/$defs/AgentBuyerInfo"
    },
    "opening_price_per_unit": {
      "minimum": 0,
      "title": "Opening Price Per Unit",
      "type": "integer"
    },
    "opening_price_unit": {
      "enum": [
        "kg",
        "dozen"
      ],
      "title": "Opening Price Unit",
      "type": "string"
    },
    "currency": {
      "const": "PKR",
      "default": "PKR",
      "title": "Currency",
      "type": "string"
    },
    "pickup_window": {
      "title": "Pickup Window",
      "type": "string"
    },
    "pickup_deadline": {
      "format": "date-time",
      "title": "Pickup Deadline",
      "type": "string"
    },
    "mart": {
      "$ref": "#/$defs/MartInfo"
    },
    "payment_terms": {
      "title": "Payment Terms",
      "type": "string"
    },
    "language": {
      "default": "ur",
      "enum": [
        "ur",
        "en",
        "pa"
      ],
      "title": "Language",
      "type": "string"
    },
    "calling_hours": {
      "$ref": "#/$defs/CallingHours"
    }
  },
  "required": [
    "mart_id",
    "batch_id",
    "call_id",
    "item",
    "condition",
    "quantity",
    "quantity_unit",
    "buyer",
    "opening_price_per_unit",
    "opening_price_unit",
    "pickup_window",
    "pickup_deadline",
    "mart",
    "payment_terms",
    "calling_hours"
  ],
  "title": "AgentDealBrief",
  "type": "object"
}